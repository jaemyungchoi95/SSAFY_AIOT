<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.kro.areuhot.spot.mapper.SpotMapper">

    <insert id="insertSpot" parameterType="kr.kro.areuhot.rack.model.Spot" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO spot (
            rack_id, x, y, direction
        )
        VALUES (
            #{rackId}, #{x}, #{y}, #{direction}
        )
    </insert>

</mapper>
